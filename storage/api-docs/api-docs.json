        "/api/product-types/{productTypeId}/products": {
            "get": {
                "tags": [
                    "Məhsul Növləri"
                ],
                "summary": "Müəyyən məhsul növü üçün məhsulları əldə et",
                "description": "Müəyyən məhsul növünə aid olan məhsulları qaytarır, ana səhifə statusu ilə",
                "operationId": "getProductsByType",
                "parameters": [
                    {
                        "name": "productTypeId",
                        "in": "path",
                        "description": "Məhsul növünün ID-si",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 2
                        }
                    },
                    {
                        "name": "locale",
                        "in": "header",
                        "description": "Dil ID-si (languages API-dən)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    },
                    {
                        "name": "homepage_only",
                        "in": "query",
                        "description": "Yalnız bu növ üçün ana səhifədə olan məhsulları qaytar",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "example": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Uğurlu cavab",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "description": "Məhsul ID-si",
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "title": {
                                                        "description": "Məhsulun başlığı",
                                                        "type": "string",
                                                        "example": "Məhsul Adı"
                                                    },
                                                    "description": {
                                                        "description": "Məhsulun təsviri",
                                                        "type": "string",
                                                        "example": "Məhsul təsviri"
                                                    },
                                                    "slug": {
                                                        "description": "Məhsulun slug-u",
                                                        "type": "string",
                                                        "example": "mehsul-adi"
                                                    },
                                                    "main_image": {
                                                        "description": "Əsas şəklin URL-i",
                                                        "type": "string",
                                                        "example": "https://admin.gardaslar.coder.az/uploads/products/image.jpg",
                                                        "nullable": true
                                                    },
                                                    "types": {
                                                        "description": "Məhsul növləri",
                                                        "type": "array",
                                                        "items": {
                                                            "properties": {
                                                                "id": {
                                                                    "description": "Növ ID-si",
                                                                    "type": "integer",
                                                                    "example": 2
                                                                },
                                                                "title": {
                                                                    "description": "Növün adı",
                                                                    "type": "string",
                                                                    "example": "Ümumi"
                                                                }
                                                            },
                                                            "type": "object"
                                                        }
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Məhsul növü tapılmadı",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Məhsul növü tapılmadı"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server xətası",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Məhsulları əldə etməkdə xəta baş verdi"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
