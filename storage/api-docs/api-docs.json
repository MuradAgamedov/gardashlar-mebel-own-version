{
    "openapi": "3.0.0",
    "info": {
        "title": "Gardashlar Admin API",
        "description": "Bu sənədləşmə Gardashlar admin panel API-ləri üçündür.",
        "contact": {
            "email": "info@gardashlar.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://admin.gardaslar.coder.az",
            "description": "Əsas server"
        }
    ],
    "paths": {
        "/api/homepage-categories": {
            "get": {
                "tags": [
                    "HomePageCategories"
                ],
                "summary": "Get all active homepage categories",
                "description": "Returns a list of active homepage categories with their product category details, ordered by 'order' field",
                "operationId": "getHomePageCategories",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "header",
                        "description": "Language_id from languages api",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "title": {
                                                        "type": "string",
                                                        "example": "Electronics"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Error retrieving homepage categories"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/languages": {
            "get": {
                "tags": [
                    "Languages"
                ],
                "summary": "Get all active languages",
                "description": "Returns a list of active languages ordered by 'order' field",
                "operationId": "getLanguages",
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "title": {
                                                        "type": "string",
                                                        "example": "Azərbaycan dili"
                                                    },
                                                    "lang_code": {
                                                        "type": "string",
                                                        "example": "az"
                                                    },
                                                    "lang_name": {
                                                        "type": "string",
                                                        "example": "Azerbaijani"
                                                    },
                                                    "is_default": {
                                                        "type": "boolean",
                                                        "example": true
                                                    },
                                                    "order": {
                                                        "type": "integer",
                                                        "example": 1
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Error retrieving languages"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/pages": {
            "get": {
                "tags": [
                    "Pages"
                ],
                "summary": "Get all pages",
                "description": "Returns all translated pages based on language ID sent via 'locale' header",
                "operationId": "getAllPages",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "header",
                        "description": "Language_id from languages api",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "keyword": {
                                                        "type": "string",
                                                        "example": "about-us"
                                                    },
                                                    "title": {
                                                        "type": "string",
                                                        "example": "Haqqımızda"
                                                    },
                                                    "slug": {
                                                        "type": "string",
                                                        "example": "haqqimizda"
                                                    },
                                                    "seo_title": {
                                                        "type": "string",
                                                        "example": "Haqqımızda"
                                                    },
                                                    "seo_keywords": {
                                                        "type": "string",
                                                        "example": "Haqqımızda, Bizim haqqımızda"
                                                    },
                                                    "seo_description": {
                                                        "type": "string",
                                                        "example": "Şirkət haqqında ümumi məlumat"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        },
        "/api/pages/{keyword}": {
            "get": {
                "tags": [
                    "Pages"
                ],
                "summary": "Get a page by keyword",
                "description": "Returns a translated page by keyword and language ID from 'locale' header",
                "operationId": "getPageByKeyword",
                "parameters": [
                    {
                        "name": "keyword",
                        "in": "path",
                        "description": "The keyword of the page",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "about-us"
                        }
                    },
                    {
                        "name": "locale",
                        "in": "header",
                        "description": "Language_id from languages api",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 2
                                                },
                                                "title": {
                                                    "type": "string",
                                                    "example": "Haqqımızda"
                                                },
                                                "slug": {
                                                    "type": "string",
                                                    "example": "haqqimizda"
                                                },
                                                "seo_title": {
                                                    "type": "string",
                                                    "example": "Haqqımızda"
                                                },
                                                "seo_keywords": {
                                                    "type": "string",
                                                    "example": "Haqqımızda, Bizim haqqımızda"
                                                },
                                                "seo_description": {
                                                    "type": "string",
                                                    "example": "Şirkət haqqında ümumi məlumat"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Keyword parameter is required"
                    },
                    "404": {
                        "description": "Page not found"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        },
        "/api/product-types": {
            "get": {
                "tags": [
                    "Product Types"
                ],
                "summary": "Get all active product types",
                "description": "Returns a list of active product types with translations (id and title only)",
                "operationId": "getProductTypes",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "header",
                        "description": "Language_id from languages api",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "title": {
                                                        "type": "string",
                                                        "example": "Electronics"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Error retrieving product types"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/product-types/{productTypeId}/products": {
            "get": {
                "tags": [
                    "Product Type Products"
                ],
                "summary": "Get products for a specific product type",
                "description": "Returns products that belong to a specific product type, with homepage status",
                "operationId": "getProductsByType",
                "parameters": [
                    {
                        "name": "productTypeId",
                        "in": "path",
                        "description": "The ID of the product type",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 2
                        }
                    },
                    {
                        "name": "locale",
                        "in": "header",
                        "description": "Language_id from languages api",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    },
                    {
                        "name": "homepage_only",
                        "in": "query",
                        "description": "Return only products that are on homepage for this type",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "example": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "title": {
                                                        "type": "string",
                                                        "example": "Product Name"
                                                    },
                                                    "description": {
                                                        "type": "string",
                                                        "example": "Product description"
                                                    },
                                                    "slug": {
                                                        "type": "string",
                                                        "example": "product-name"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Product type not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Product type not found"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Error retrieving products"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "HomePageCategories",
            "description": "HomePageCategories"
        },
        {
            "name": "Languages",
            "description": "Languages"
