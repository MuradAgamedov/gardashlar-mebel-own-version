{
    "openapi": "3.0.0",
    "info": {
        "title": "Gardashlar Admin API",
        "description": "Bu sənədləşmə Gardashlar admin panel API-ləri üçündür.",
        "contact": {
            "email": "info@gardashlar.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://admin.gardaslar.coder.az",
            "description": "Əsas server"
        }
    ],
    "paths": {
        "/api/hero-categories": {
            "get": {
                "tags": [
                    "HeroCategories"
                ],
                "summary": "Get all active hero categories",
                "description": "Returns a list of active hero categories with their product category details, ordered by 'order' field",
                "operationId": "getHeroCategories",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "header",
                        "description": "Language_id from languages api",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "title": {
                                                        "type": "string",
                                                        "example": "Electronics"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Error retrieving hero categories"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
