    },
    "servers": [
        {
            "url": "https://admin.gardaslar.coder.az",
            "description": "Əsas server"
        }
    ],
    "paths": {
        "/api/homepage-categories": {
            "get": {
                "tags": [
                    "HomePageCategories"
                ],
                "summary": "Get all active homepage categories",
                "description": "Returns a list of active homepage categories with their product category details, ordered by 'order' field",
                "operationId": "getHomePageCategories",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "header",
                        "description": "Language_id from languages api",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "order": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "status": {
                                                        "type": "boolean",
                                                        "example": true
                                                    },
                                                    "product_category": {
                                                        "properties": {
                                                            "id": {
                                                                "type": "integer",
                                                                "example": 1
                                                            },
                                                            "parent_id": {
                                                                "type": "integer",
                                                                "example": null,
                                                                "nullable": true
                                                            },
                                                            "order": {
                                                                "type": "integer",
                                                                "example": 1
                                                            },
                                                            "status": {
                                                                "type": "boolean",
                                                                "example": true
                                                            },
                                                            "image": {
                                                                "type": "string",
                                                                "example": "categories/category1.jpg",
                                                                "nullable": true
                                                            },
                                                            "title": {
                                                                "type": "string",
                                                                "example": "Electronics"
                                                            },
                                                            "slug": {
                                                                "type": "string",
                                                                "example": "electronics"
                                                            },
                                                            "description": {
                                                                "type": "string",
                                                                "example": "Electronic products category",
                                                                "nullable": true
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Error retrieving homepage categories"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/homepage-categories/{id}": {
            "get": {
                "tags": [
                    "HomePageCategories"
                ],
                "summary": "Get a specific homepage category",
                "description": "Returns a specific homepage category with its product category details",
                "operationId": "getHomePageCategory",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "HomePageCategory ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    },
                    {
                        "name": "locale",
                        "in": "header",
                        "description": "Language_id from languages api",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "order": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "status": {
                                                    "type": "boolean",
                                                    "example": true
                                                },
                                                "product_category": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "integer",
                                                            "example": 1
                                                        },
                                                        "parent_id": {
                                                            "type": "integer",
                                                            "example": null,
                                                            "nullable": true
                                                        },
                                                        "order": {
                                                            "type": "integer",
                                                            "example": 1
                                                        },
                                                        "status": {
                                                            "type": "boolean",
                                                            "example": true
                                                        },
                                                        "image": {
                                                            "type": "string",
                                                            "example": "categories/category1.jpg",
                                                            "nullable": true
                                                        },
                                                        "title": {
                                                            "type": "string",
                                                            "example": "Electronics"
                                                        },
                                                        "slug": {
                                                            "type": "string",
                                                            "example": "electronics"
                                                        },
                                                        "description": {
                                                            "type": "string",
                                                            "example": "Electronic products category",
                                                            "nullable": true
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "HomePageCategory not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "HomePageCategory not found"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Error retrieving homepage category"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/languages": {
            "get": {
                "tags": [
                    "Languages"
                ],
                "summary": "Get all active languages",
                "description": "Returns a list of active languages ordered by 'order' field",
                "operationId": "getLanguages",
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "title": {
                                                        "type": "string",
                                                        "example": "Azərbaycan dili"
                                                    },
                                                    "lang_code": {
                                                        "type": "string",
                                                        "example": "az"
                                                    },
                                                    "lang_name": {
                                                        "type": "string",
                                                        "example": "Azerbaijani"
                                                    },
                                                    "is_default": {
                                                        "type": "boolean",
                                                        "example": true
                                                    },
                                                    "order": {
                                                        "type": "integer",
                                                        "example": 1
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Error retrieving languages"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/pages": {
            "get": {
                "tags": [
                    "Pages"
                ],
                "summary": "Get all pages",
                "description": "Returns all translated pages based on language ID sent via 'locale' header",
                "operationId": "getAllPages",
                "parameters": [
                    {
                        "name": "locale",
                        "in": "header",
                        "description": "Language_id from languages api",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "keyword": {
                                                        "type": "string",
                                                        "example": "about-us"
                                                    },
                                                    "title": {
                                                        "type": "string",
                                                        "example": "Haqqımızda"
                                                    },
                                                    "slug": {
                                                        "type": "string",
                                                        "example": "haqqimizda"
                                                    },
                                                    "seo_title": {
                                                        "type": "string",
                                                        "example": "Haqqımızda"
                                                    },
                                                    "seo_keywords": {
                                                        "type": "string",
                                                        "example": "Haqqımızda, Bizim haqqımızda"
                                                    },
                                                    "seo_description": {
                                                        "type": "string",
                                                        "example": "Şirkət haqqında ümumi məlumat"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        },
        "/api/pages/{keyword}": {
            "get": {
                "tags": [
                    "Pages"
                ],
                "summary": "Get a page by keyword",
                "description": "Returns a translated page by keyword and language ID from 'locale' header",
                "operationId": "getPageByKeyword",
                "parameters": [
                    {
                        "name": "keyword",
                        "in": "path",
                        "description": "The keyword of the page",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "about-us"
                        }
                    },
                    {
                        "name": "locale",
                        "in": "header",
                        "description": "Language_id from languages api",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 2
                                                },
                                                "title": {
                                                    "type": "string",
                                                    "example": "Haqqımızda"
                                                },
                                                "slug": {
                                                    "type": "string",
                                                    "example": "haqqimizda"
                                                },
                                                "seo_title": {
                                                    "type": "string",
                                                    "example": "Haqqımızda"
                                                },
                                                "seo_keywords": {
                                                    "type": "string",
                                                    "example": "Haqqımızda, Bizim haqqımızda"
                                                },
                                                "seo_description": {
                                                    "type": "string",
                                                    "example": "Şirkət haqqında ümumi məlumat"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Keyword parameter is required"
                    },
                    "404": {
                        "description": "Page not found"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        }
    },
